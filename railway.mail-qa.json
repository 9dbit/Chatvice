{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.mail-qa"
  },
  "deploy": {
    "startCommand": "node dist/mail-qa-server.cjs",
    "preDeployCommand": ["node scripts/mail-qa-bootstrap.mjs"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}
