# Mail QA only. Select explicitly on Chatvice-Mail-QA; other services do not use it.
FROM node:22-bookworm-slim AS build
WORKDIR /build
ENV PUPPETEER_SKIP_DOWNLOAD=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY client ./client
COPY server ./server
COPY shared ./shared
COPY script/build-mail-qa.ts ./script/build-mail-qa.ts
COPY tsconfig.json tailwind.config.ts postcss.config.js vite.mail-qa.config.ts ./
RUN node --import tsx script/build-mail-qa.ts

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=5000
WORKDIR /app
COPY config/mail-qa-runtime/package.json config/mail-qa-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY --from=build --chown=node:node /build/dist/mail-qa ./dist/mail-qa
COPY --from=build --chown=node:node /build/dist/mail-qa-server.cjs ./dist/mail-qa-server.cjs
COPY --chown=node:node scripts/mail-qa-bootstrap.mjs ./scripts/mail-qa-bootstrap.mjs
COPY --chown=node:node migrations/20261026_chatvice_mail_v1.sql migrations/20261026_chatvice_mail_attachments_v2.sql migrations/20261027_chatvice_mail_delivery_recipients_v3.sql ./migrations/
USER node
EXPOSE 5000
CMD ["node", "dist/mail-qa-server.cjs"]
