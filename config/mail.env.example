# Optional Chatvice Mail Engine V1 configuration.
# Do not enable or deploy before isolated staging DB migration, provider verification
# and privacy/security checks in docs/CHATVICE_MAIL_V1.md.
CHATVICE_MAIL_ENABLED=false
CHATVICE_MAIL_OUTBOUND_ENABLED=false
CHATVICE_MAIL_PROVIDER=resend
# Exact origins only. Comma-separated, including https://
CHATVICE_MAIL_ALLOWED_ORIGINS=https://staging.example.invalid
# For normalized inbound adapters only; use 32+ random characters
CHATVICE_MAIL_INBOUND_SECRET=
# Server-side only; never place keys in Vite PUBLIC_ variables
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# AI Mail is OFF until the merchant explicitly enables external AI processing.
# All requests still require user action plus explicit in-app consent.
CHATVICE_MAIL_AI_ENABLED=false
CHATVICE_MAIL_AI_API_KEY=
CHATVICE_MAIL_AI_MODEL=gpt-4.1-mini
